# Web版(リモート HTTP MCP)の環境変数サンプル。
# ローカルでは Node 20+ の --env-file で読み込めます:
#   npm run build && node --env-file=.env dist/http.js
# Render/Cloud Run ではダッシュボード/Blueprint 側に同じ値を設定してください。

# --- HTTP ---
# 公開 URL(末尾スラッシュ無し)。ローカル検証時は http://localhost:8080 でも可。
PUBLIC_URL=https://YOUR-SERVICE.onrender.com
# 任意。未設定なら 8080。Render/Cloud Run は PORT を注入するので通常不要。
# HTTP_PORT=8080

# --- FHIR 接続(固定 SMART Backend Services クレデンシャル) ---
FHIR_BASE_URL=http://localhost:3000
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_MCP_ALLOW_WRITES=false
FHIR_MCP_MAX_COUNT=50

# --- OAuth(外部 IdP へ委譲)。以下は Auth0 の例 ---
# テナントの .well-known/openid-configuration の値に合わせる。
# 詳しい取得手順は docs/auth0-setup.md を参照。
OAUTH_ISSUER_URL=https://YOUR_TENANT.us.auth0.com/
OAUTH_AUTHORIZATION_URL=https://YOUR_TENANT.us.auth0.com/authorize
OAUTH_TOKEN_URL=https://YOUR_TENANT.us.auth0.com/oauth/token
OAUTH_JWKS_URL=https://YOUR_TENANT.us.auth0.com/.well-known/jwks.json
# Dynamic Client Registration を使う場合(Claude アプリが自動でクライアント登録する)
OAUTH_REGISTRATION_URL=https://YOUR_TENANT.us.auth0.com/oidc/register
# Auth0 で作成した API の Identifier(= access token の aud)。作成後変更不可のため、
# ホスティング先 URL に紐づけず安定した論理 URI にする。Auth0 側と完全一致させること。
OAUTH_AUDIENCE=https://fhir-mcp-server/api

# --- 検証専用(scripts/verify-oauth.sh 用)。本番デプロイには不要 ---
# Auth0 で作成した Machine-to-Machine アプリの資格情報(対象 API を authorize しておく)。
VERIFY_M2M_CLIENT_ID=
VERIFY_M2M_CLIENT_SECRET=
